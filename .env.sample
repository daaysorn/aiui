# Copy to .env.local:
#   cp .env.sample .env.local

# Nest API origin (no trailing slash). Used by the Better Auth browser client.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Canonical site URL for metadata and server-side auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Autumn secret for the Next.js `/api/autumn` handler (server-only).
# Must match builderbackend AUTUMN_SECRET_KEY when billing is enabled.
# AUTUMN_SECRET_KEY=am_sk_test_xxx

# Optional override for the metered credits feature id (default: credits).
# NEXT_PUBLIC_AUTUMN_CREDITS_FEATURE_ID=credits

# Optional server-only API origin. Falls back to NEXT_PUBLIC_API_URL.
# API_URL=http://localhost:3000

# Eve talks to Nest for gateway policy + credentials (server-only).
# Copy EVE_GATEWAY_INTERNAL_TOKEN from builderbackend/.env — same value in both apps.
# EVE_GATEWAY_INTERNAL_TOKEN=
#
# Gateway provider secrets live in builderbackend/.env only (AI_GATEWAY_API_KEY, CENCORI_API_KEY, etc.).

# --- Eve workflow Postgres (required for durable chat) ---
# Dedicated DB, not the Nest app DB.
#
# Local (recommended for fast chat in dev):
#   bun run workflow:db:up
#   bun run workflow:setup
WORKFLOW_POSTGRES_URL=postgresql://eve:eve@127.0.0.1:5433/eve_workflow
#
# Neon (remote — higher latency): use the DIRECT host (no `-pooler`).
# Eve streams via LISTEN/NOTIFY; Neon's pooler breaks streaming.
# Bad:  ep-xxx-pooler.…neon.tech
# Good: ep-xxx.…neon.tech
#
# WORKFLOW_POSTGRES_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&uselibpqcompat=true
#
# Local vs Coolify MUST use different job prefixes if they share a DB.
WORKFLOW_POSTGRES_JOB_PREFIX=daaybot_dev
WORKFLOW_POSTGRES_WORKER_CONCURRENCY=8
WORKFLOW_POSTGRES_MAX_POOL_SIZE=10
#
# Coolify production example:
#   WORKFLOW_POSTGRES_JOB_PREFIX=daaybot
#   WORKFLOW_POSTGRES_WORKER_CONCURRENCY=8
#   WORKFLOW_POSTGRES_MAX_POOL_SIZE=10
#
# Coolify / self-host: `bun run start` boots Eve then Next.
# Schema bootstrap runs on start (`workflow:setup`). Skip only when needed:
#   SKIP_WORKFLOW_SETUP=1 bun run build

# Cloudflare Turnstile site key. Localhost always uses Cloudflare's visible
# always-pass test key; set this for deployed environments.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAD4zHaK9bnCci6glplo

# Optional legal URL overrides (defaults are /terms and /privacy).
# NEXT_PUBLIC_TERMS_URL=/terms
# NEXT_PUBLIC_PRIVACY_URL=/privacy

# Show chat suggestion chips on the dashboard overview. Off unless set.
# NEXT_PUBLIC_CHAT_SUGGESTIONS=true
