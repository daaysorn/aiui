# Nest API base URL (browser hits this directly; CORS must allow this app origin)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Public browser URL for this Next app
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Cloudflare Turnstile sitekey. Localhost always uses Cloudflare's always-pass
# test widget (1x00000000000000000000AA) even if this is set.
# Production: set the real widget sitekey from the Cloudflare dashboard.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
